# cubefs-client-exporter 配置示例(systemd EnvironmentFile)
# 复制为 /etc/cubefs/exporter.conf 并按需修改,然后:
#   systemctl restart cubefs-client-exporter
#
# EXPORTER_OPTS 透传给 cubefs-client-exporter。可用项(此处为默认值):
#   -listen=:9970                   metrics HTTP 监听地址
#   -mountpoint=/mnt/cubefs-kernel  cubefs 内核挂载点
#   -vol=cubefs-2rep-vol            卷名(用于 /proc/fs/cubefs/<vol>/log 路径)
#   -proc=/proc -sys=/sys           节点 procfs/sysfs(systemd 节点级用 /proc /sys)
#   -kmsg=/dev/kmsg                 内核日志(oops/BUG 计数)
#   -node=<主机名>                  node 标签(默认 hostname,或 $NODE_NAME 环境变量)
#
# 默认值已适配 test-hb(cubefs-2rep-vol);非默认卷/挂载点在此覆盖。
EXPORTER_OPTS="-vol=cubefs-2rep-vol -mountpoint=/mnt/cubefs-kernel -listen=:9970"
